{
  "name": "tau-moodle-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build:client": "vite build",
    "build": "npm run build:client && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply tau-moodle-calendar --local",
    "db:migrate:remote": "wrangler d1 migrations apply tau-moodle-calendar --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build:client && wrangler deploy",
    "preview": "npm run build:client && wrangler dev"
  },
  "dependencies": {
    "hono": "^4.12.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.0",
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.70.0"
  }
}
