{
  "manifest_version": 3,
  "name": "TAU Moodle Calendar Auto-Sync",
  "version": "1.0.0",
  "description": "Automatically syncs Tel Aviv University Moodle deadlines and problem set submission status to your Apple & Google Calendar.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://moodle.tau.ac.il/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://moodle.tau.ac.il/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TAU Moodle Calendar Sync"
  }
}
